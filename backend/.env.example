# IndiaLens Backend — Environment Variables
# Copy to .env and fill in real values before running

# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://indialens:indialens_dev@localhost:5432/indialens
DATABASE_URL_SYNC=postgresql://indialens:indialens_dev@localhost:5432/indialens

# ── Redis ─────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── FastAPI ───────────────────────────────────────────────────────
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
API_KEY_ADMIN=change-me-admin-key
FRONTEND_URL=https://indialens.in
ENVIRONMENT=development
DEBUG=true

# ── Reddit API (PRAW) ─────────────────────────────────────────────
# Register at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret

# ── World Bank PPP ────────────────────────────────────────────────
PPP_FACTOR_INR_PER_USD=23.1

# ── Model ─────────────────────────────────────────────────────────
CURRENT_MODEL_VERSION=v1.0-seed

# ── Sentry (optional) ─────────────────────────────────────────────
# SENTRY_DSN=https://...@sentry.io/...
SENTRY_DSN=
RESEND_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=indialens-reports

# ── Smart Scraping Layer (Tavily) ─────────────────────────────────
# Get free key at https://app.tavily.com (1000 free searches/month)
TAVILY_API_KEY=your-tavily-api-key

# ── External Open & Free APIs ──────────────────────────────────────
# Data.gov.in (AISHE / MoSPI): Register at https://data.gov.in
DATA_GOV_IN_API_KEY=your-data-gov-key

# Adzuna Jobs (India): Register at https://developer.adzuna.com
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# RapidAPI JSearch: Register at https://rapidapi.com (JSearch free tier)
RAPIDAPI_JSEARCH_KEY=your-rapidapi-key

# GitHub Personal Access Token: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_token

# ── AI Services (Free Tiers) ──────────────────────────────────────
# Google Gemini API: Get free key at https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key

# Hugging Face Access Token: Get at https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_huggingface_token

