# IndiaLens Frontend — Local Environment
# Copy to .env.local (already in .gitignore)

# FastAPI backend URL (change to http://localhost:8000 when backend is running)
FASTAPI_URL=http://localhost:8000

# Next.js public env (exposed to browser)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=1.0.0-seed
